{
    "entryPoints": [
        "./src/OSFramework/DataGrid/**/*.ts",
        "./src/OutSystems/OutSystems.ts",
        "./src/Providers/DataGrid/**/*.ts"
    ],
    "entryPointStrategy": "expand",
    "plugin": [
        "typedoc-umlclass",
        "typedoc-plugin-merge-modules"
    ],
    "includeVersion": true,
    "hideGenerator": true,
    "out": "./docs",
    "sort": [
        "source-order"
    ],
    "blockTags": [
        "@alpha",
        "@beta",
        "@defaultValue",
        "@deprecated",
        "@example",
        "@experimental",
        "@internal",
        "@override",
        "@param",
        "@privateRemarks",
        "@public",
        "@remarks",
        "@returns",
        "@sealed",
        "@see",
        "@throws",
        "@virtual",
        "@memberof",
        "@export",
        "@static",
        "@todo",
        "@return",
        "@extends",
        "@template",
        "@type",
        "@implements"
    ],
    "umlClassDiagram": {
        "type": "detailed",
        "location": "local",
        "format": "svg",
        "backgroundColor": "#ced4da",
        "boxBackgroundColor": "#fff",
        "boxBorderColor": "#272b30",
        "arrowColor": "#272b30"
    },
    "customCss": "typedoc-custom.css",
    "validation": {
        "notExported": false,
        "invalidLink": true,
        "notDocumented": false
    }
}
